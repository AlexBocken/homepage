{
  "name": "homepage",
  "version": "2.145.59",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "postinstall": "node scripts/sharp-heic.mjs",
    "dev": "NODE_OPTIONS='--disable-warning=DEP0205' vite dev",
    "prebuild": "bash scripts/subset-emoji-font.sh && pnpm exec vite-node scripts/generate-mystery-verses.ts && pnpm exec vite-node scripts/download-models.ts && pnpm exec vite-node scripts/generate-loyalty-cards.ts && pnpm exec vite-node scripts/generate-error-quotes.ts && pnpm run hikes:build && pnpm exec vite-node scripts/build-private-images.ts && pnpm exec vite-node scripts/build-static-blur.ts",
    "build": "vite build",
    "postbuild": "pnpm exec vite-node scripts/build-error-page.ts && UV_THREADPOOL_SIZE=12 pnpm exec vite-node scripts/precompress.ts",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "pnpm run test:units && pnpm run test:e2e",
    "test:units": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "NODE_OPTIONS='--disable-warning=DEP0205' bash scripts/e2e/run.sh",
    "test:e2e:keep": "KEEP_UP=1 NODE_OPTIONS='--disable-warning=DEP0205' bash scripts/e2e/run.sh",
    "test:e2e:ui": "KEEP_UP=1 NODE_OPTIONS='--disable-warning=DEP0205' bash scripts/e2e/run.sh --ui",
    "e2e:up": "docker compose -f docker-compose.test.yml up -d --wait && node scripts/e2e/provision-authentik.mjs && node scripts/e2e/clone-dev.mjs && node scripts/e2e/seed.mjs",
    "e2e:down": "docker compose -f docker-compose.test.yml down -v",
    "e2e:seed": "node scripts/e2e/clone-dev.mjs && node scripts/e2e/seed.mjs",
    "deploy": "bash scripts/deploy.sh",
    "deploy:gitea": "sh scripts/deploy-gitea.sh",
    "deploy:searxng": "sh scripts/deploy-searxng.sh",
    "deploy:dry": "bash scripts/deploy.sh --dry-run",
    "hikes:build": "pnpm exec vite-node scripts/build-hikes.ts",
    "static:blur": "pnpm exec vite-node scripts/build-static-blur.ts",
    "hikes:alt": "pnpm exec vite-node scripts/generate-hike-alt-text.ts",
    "hikes:travel": "pnpm exec vite-node scripts/build-hike-travel.ts",
    "hikes:translate": "pnpm exec vite-node scripts/translate-hikes.ts",
    "ccc:import": "pnpm exec vite-node scripts/build-ccc.ts",
    "council:import": "pnpm exec vite-node scripts/build-council.ts",
    "cic:import": "pnpm exec vite-node scripts/build-cic.ts",
    "magisterium:import": "pnpm exec vite-node scripts/build-magisterium.ts",
    "bible:import": "pnpm exec vite-node scripts/import-allioli.ts",
    "bible:font": "pnpm exec vite-node scripts/build-bible-font.ts",
    "bible:words": "pnpm exec vite-node scripts/build-bible-words.ts",
    "bible:fathers": "pnpm exec vite-node scripts/build-fathers.ts",
    "bible:fathers:blur": "pnpm exec vite-node scripts/build-fathers-blur.ts",
    "commentary:import": "pnpm exec vite-node scripts/import-commentary.ts",
    "photos:push": "bash scripts/hike-photos.sh push",
    "photos:pull": "bash scripts/hike-photos.sh pull",
    "trace:stickers": "node scripts/trace-sticker-silhouettes.mjs",
    "tauri": "tauri"
  },
  "packageManager": "pnpm@11.3.0",
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@sveltejs/enhanced-img": "^0.10.4",
    "@sveltejs/kit": "^2.57.1",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@tauri-apps/cli": "^2.10.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.3.1",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^22.12.0",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.0",
    "@vitest/ui": "^4.1.2",
    "bwip-js": "^4.10.1",
    "imagetracerjs": "^1.2.6",
    "jsdom": "^27.2.0",
    "mdsvex": "^0.12.7",
    "node-addon-api": "^8.9.2",
    "node-gyp": "^13.0.1",
    "potrace": "^2.1.8",
    "svelte": "^5.55.7",
    "svelte-check": "^4.4.6",
    "svgo": "^4.1.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.16",
    "vite-node": "^6.0.0",
    "vitest": "^4.1.2"
  },
  "dependencies": {
    "@auth/sveltekit": "^1.11.3",
    "@huggingface/transformers": "^4.0.1",
    "@lucide/svelte": "^1.7.0",
    "@maplibre/maplibre-gl-leaflet": "^0.1.4",
    "@mediapipe/tasks-vision": "^0.10.35",
    "@sveltejs/adapter-node": "^5.5.4",
    "@tauri-apps/plugin-geolocation": "^2.3.2",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "barcode-detector": "^3.1.2",
    "chart.js": "^4.5.1",
    "chartjs-adapter-date-fns": "^3.0.0",
    "date-fns": "^4.1.0",
    "exifr": "^7.1.3",
    "file-type": "^21.3.1",
    "leaflet": "^1.9.4",
    "maplibre-gl": "^6.10.0",
    "mongoose": "^9.4.1",
    "node-cron": "^4.2.1",
    "nodemailer": "^9.0.1",
    "romcal": "github:AlexBocken/romcal#dev",
    "sharp": "^0.35.0",
    "socks": "^2.8.9",
    "web-haptics": "^0.0.6"
  }
}
