# E2E test environment. All values are fixed constants that match the
# docker-compose.test.yml stack + the Authentik provisioning script. Safe to
# commit: it only ever points at the throwaway local test containers.
#
# Loaded by playwright.config.ts (via dotenv) and injected into the build+preview
# webServer, so both $env/static/private (baked at build) and $env/dynamic/private
# (read at runtime) resolve to these.

# --- Throwaway Mongo (docker-compose.test.yml) ---
MONGO_URL="mongodb://localhost:27018/bocken_test?directConnection=true"

# --- Authentik test IdP (docker-compose.test.yml + provision-authentik.mjs) ---
# Issuer is derived from the application slug: /application/o/<slug>/
AUTHENTIK_ISSUER="http://localhost:9100/application/o/bocken-test/"
AUTHENTIK_ID="bocken-e2e-client-id"
AUTHENTIK_SECRET="bocken-e2e-client-secret-0123456789abcdef"
# = AUTHENTIK_BOOTSTRAP_TOKEN in the compose file (akadmin's API token).
AUTHENTIK_API_TOKEN="e2e-authentik-admin-api-token-0123456789abcdef"

# --- Auth.js ---
AUTH_SECRET="e2e-auth-secret-not-for-production-00000000000000"
# adapter-node needs the canonical origin for the sign-in/out POST (CSRF) to work.
ORIGIN="http://localhost:4173"

# --- App runtime config ---
# Where recipe/user image uploads are written during tests.
IMAGE_DIR="/home/alex/.local/src/homepage_new/tests/e2e/.tmp/images"
ALLOW_REGISTRATION="1"

# Dummy SMTP so the mailer module loads; email-change verification is not
# exercised in the current test scope.
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_SECURE="false"
SMTP_USER="noreply@e2e.local"
SMTP_PASS="unused"
SMTP_FROM="Bocken E2E <noreply@e2e.local>"
GROUP_REQUEST_TO="admin@e2e.local"

# --- Test-only knobs consumed by the Playwright harness / provisioning ---
# Shared password for every seeded Authentik test user.
E2E_USER_PASSWORD="e2e-user-password-123"
AUTHENTIK_TAG="2026.5.3"

# Path to the on-disk CSV where /finances categorizations are stored
# (schema: key,account,date,amount,payee,narration). Pulled into the ledger
# repo by accounting/tools/pull_overrides.sh.
FINANCE_OVERRIDES_CSV="/home/alex/.local/src/homepage_new/tests/e2e/.tmp/finance-overrides.csv"
